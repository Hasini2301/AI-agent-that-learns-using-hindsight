# Optional live Hindsight setup. Copy values into your shell/environment; do not commit real keys.
SIGNALOPS_MEMORY_PROVIDER=hindsight
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=replace-with-your-server-side-key
HINDSIGHT_BANK_ID=signalops-team
HINDSIGHT_TIMEOUT_SECONDS=8
# For a trusted, private self-hosted HTTP instance only:
# HINDSIGHT_ALLOW_INSECURE_HTTP=1
# HINDSIGHT_API_URL=http://127.0.0.1:8888
